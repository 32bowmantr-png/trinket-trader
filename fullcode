<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trinket Trader</title>
  <script src="/_sdk/element_sdk.js"></script>
  <style>
        body {
            box-sizing: border-box;
            margin: 0;
            padding: 20px;
            font-family: 'Courier New', monospace;
            background: linear-gradient(135deg, #2c3e50, #34495e);
            color: #ecf0f1;
            min-height: 100%;
        }
        
        .game-container {
            max-width: 1200px;
            margin: 0 auto;
            background: rgba(44, 62, 80, 0.9);
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        
        .game-title {
            font-size: 2.5rem;
            color: #f39c12;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
            margin-bottom: 10px;
        }
        
        .shop-name {
            font-size: 1.5rem;
            color: #3498db;
            margin-bottom: 20px;
        }
        
        .stats-panel {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        
        .stat-card {
            background: rgba(52, 73, 94, 0.8);
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            border: 2px solid #34495e;
        }
        
        .stat-value {
            font-size: 2rem;
            font-weight: bold;
            color: #2ecc71;
        }
        
        .stat-label {
            font-size: 0.9rem;
            color: #bdc3c7;
            margin-top: 5px;
        }
        
        .game-area {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }
        
        .panel {
            background: rgba(52, 73, 94, 0.6);
            padding: 25px;
            border-radius: 12px;
            border: 2px solid #34495e;
        }
        
        .panel h3 {
            color: #f39c12;
            margin-bottom: 20px;
            font-size: 1.4rem;
            text-align: center;
        }
        
        .market-button {
            width: 100%;
            padding: 15px;
            margin: 10px 0;
            border: none;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }
        
        .normal-market {
            background: #3498db;
            color: white;
        }
        
        .normal-market:hover {
            background: #2980b9;
            transform: translateY(-2px);
        }
        
        .black-market {
            background: #e74c3c;
            color: white;
        }
        
        .black-market:hover {
            background: #c0392b;
            transform: translateY(-2px);
        }
        
        .illegal-market {
            background: #8e44ad;
            color: white;
        }
        
        .illegal-market:hover {
            background: #7d3c98;
            transform: translateY(-2px);
        }
        
        .sell-button {
            background: #2ecc71;
            color: white;
        }
        
        .sell-button:hover {
            background: #27ae60;
            transform: translateY(-2px);
        }
        
        .ticket-button {
            background: #f39c12;
            color: white;
            font-size: 1.3rem;
            padding: 20px;
        }
        
        .ticket-button:hover {
            background: #e67e22;
            transform: translateY(-2px);
        }
        
        .inventory {
            background: rgba(52, 73, 94, 0.6);
            padding: 25px;
            border-radius: 12px;
            border: 2px solid #34495e;
            margin-bottom: 20px;
        }
        
        .inventory h3 {
            color: #f39c12;
            margin-bottom: 15px;
        }
        
        .inventory-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 15px;
        }
        
        .inventory-item {
            background: rgba(44, 62, 80, 0.8);
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            border: 1px solid #34495e;
        }
        
        .item-name {
            font-weight: bold;
            color: #3498db;
            margin-bottom: 5px;
        }
        
        .item-count {
            color: #2ecc71;
            font-size: 1.2rem;
        }
        
        .events-log {
            background: rgba(52, 73, 94, 0.6);
            padding: 20px;
            border-radius: 12px;
            border: 2px solid #34495e;
            height: 200px;
            overflow-y: auto;
        }
        
        .events-log h3 {
            color: #f39c12;
            margin-bottom: 15px;
        }
        
        .event {
            padding: 8px;
            margin: 5px 0;
            border-radius: 5px;
            font-size: 0.9rem;
        }
        
        .event-normal { background: rgba(52, 152, 219, 0.2); }
        .event-warning { background: rgba(241, 196, 15, 0.2); }
        .event-danger { background: rgba(231, 76, 60, 0.2); }
        .event-success { background: rgba(46, 204, 113, 0.2); }
        
        .disabled {
            opacity: 0.5;
            cursor: not-allowed !important;
        }
        
        .disabled:hover {
            transform: none !important;
        }
        
        @media (max-width: 768px) {
            .game-area {
                grid-template-columns: 1fr;
            }
            
            .stats-panel {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
  <style>@view-transition { navigation: auto; }</style>
  <script src="/_sdk/data_sdk.js" type="text/javascript"></script>
  <script src="https://cdn.tailwindcss.com" type="text/javascript"></script>
 </head>
 <body>
  <div class="game-container">
   <div class="header">
    <h1 class="game-title" id="gameTitle">Trinket Trader</h1>
    <h2 class="shop-name" id="shopName">Your Trinket Emporium</h2>
   </div>
   <div class="stats-panel">
    <div class="stat-card">
     <div class="stat-value" id="money">
      $50
     </div>
     <div class="stat-label">
      Cash
     </div>
    </div>
    <div class="stat-card">
     <div class="stat-value" id="day">
      1
     </div>
     <div class="stat-label">
      Day
     </div>
    </div>
    <div class="stat-card">
     <div class="stat-value" id="blackMarketPurchases">
      0/3
     </div>
     <div class="stat-label">
      Black Market Today
     </div>
    </div>
    <div class="stat-card">
     <div class="stat-value" id="goal">
      $1000
     </div>
     <div class="stat-label">
      Goal
     </div>
    </div>
   </div>
   <div class="inventory">
    <h3>📦 Inventory</h3>
    <div class="inventory-grid" id="inventoryGrid">
     <div class="inventory-item">
      <div class="item-name">
       No items yet
      </div>
      <div class="item-count">
       Start buying!
      </div>
     </div>
    </div>
   </div>
   <div class="game-area">
    <div class="panel">
     <h3>🏪 Markets</h3><button class="market-button normal-market" onclick="buyFromNormalMarket()"> Buy from Normal Store ($15) </button> <button class="market-button black-market" id="blackMarketBtn" onclick="buyFromBlackMarket()"> Buy from Black Market ($8) - RISKY! </button> <button class="market-button illegal-market" onclick="buyFromIllegalMarket()"> Buy from Underground ($500) - VERY RISKY! </button> <button class="market-button sell-button" onclick="sellAtAuction()"> 🔨 Sell at Auction </button>
    </div>
    <div class="panel">
     <h3>✈️ Escape Route</h3><button class="market-button ticket-button" id="ticketBtn" onclick="buyTicket()"> Buy Plane Ticket to Arabia ($1000) </button>
     <div style="text-align: center; margin-top: 15px; color: #bdc3c7;">
      Escape the country with your fortune!
     </div>
    </div>
   </div>
   <div class="events-log">
    <h3>📰 Daily Events</h3>
    <div id="eventsContainer">
     <div class="event event-normal">
      Welcome to the trinket business! Buy low, sell high, avoid the law.
     </div>
    </div>
   </div>
  </div>
  <script>
        // Game state
        let gameState = {
            money: 50,
            day: 1,
            inventory: {},
            blackMarketPurchasesToday: 0,
            gameRunning: true,
            lastTaxDay: 0,
            lastPoliceDay: 0
        };

        // Default configuration
        const defaultConfig = {
            game_title: "Trinket Trader",
            shop_name: "Your Trinket Emporium"
        };

        // Trinket types
        const trinkets = [
            "Golden Compass", "Silver Locket", "Jade Figurine", "Crystal Ball",
            "Antique Watch", "Ruby Ring", "Emerald Pendant", "Diamond Brooch",
            "Pearl Necklace", "Sapphire Earrings", "Bronze Statue", "Ivory Carving"
        ];

        // Initialize Element SDK
        if (window.elementSdk) {
            window.elementSdk.init({
                defaultConfig: defaultConfig,
                onConfigChange: async (config) => {
                    document.getElementById('gameTitle').textContent = config.game_title || defaultConfig.game_title;
                    document.getElementById('shopName').textContent = config.shop_name || defaultConfig.shop_name;
                },
                mapToCapabilities: (config) => ({
                    recolorables: [
                        {
                            get: () => config.primary_color || "#f39c12",
                            set: (value) => {
                                config.primary_color = value;
                                window.elementSdk.setConfig({ primary_color: value });
                            }
                        }
                    ],
                    borderables: [],
                    fontEditable: undefined,
                    fontSizeable: undefined
                }),
                mapToEditPanelValues: (config) => new Map([
                    ["game_title", config.game_title || defaultConfig.game_title],
                    ["shop_name", config.shop_name || defaultConfig.shop_name]
                ])
            });
        }

        function updateDisplay() {
            document.getElementById('money').textContent = `$${gameState.money}`;
            document.getElementById('day').textContent = gameState.day;
            document.getElementById('blackMarketPurchases').textContent = `${gameState.blackMarketPurchasesToday}/3`;
            
            // Update inventory display
            const inventoryGrid = document.getElementById('inventoryGrid');
            if (Object.keys(gameState.inventory).length === 0) {
                inventoryGrid.innerHTML = '<div class="inventory-item"><div class="item-name">No items yet</div><div class="item-count">Start buying!</div></div>';
            } else {
                inventoryGrid.innerHTML = '';
                for (const [item, count] of Object.entries(gameState.inventory)) {
                    const itemDiv = document.createElement('div');
                    itemDiv.className = 'inventory-item';
                    itemDiv.innerHTML = `
                        <div class="item-name">${item}</div>
                        <div class="item-count">${count}</div>
                    `;
                    inventoryGrid.appendChild(itemDiv);
                }
            }
            
            // Update button states based on money and availability
            const normalMarketBtn = document.querySelector('.normal-market');
            if (gameState.money < 15) {
                normalMarketBtn.classList.add('disabled');
                normalMarketBtn.textContent = 'Buy from Normal Store ($15) - Need More Money';
            } else {
                normalMarketBtn.classList.remove('disabled');
                normalMarketBtn.textContent = 'Buy from Normal Store ($15)';
            }
            
            const blackMarketBtn = document.getElementById('blackMarketBtn');
            if (gameState.blackMarketPurchasesToday >= 3) {
                blackMarketBtn.classList.add('disabled');
                blackMarketBtn.textContent = 'Black Market Closed Today';
            } else if (gameState.money < 8) {
                blackMarketBtn.classList.add('disabled');
                blackMarketBtn.textContent = 'Buy from Black Market ($8) - Need More Money';
            } else {
                blackMarketBtn.classList.remove('disabled');
                blackMarketBtn.textContent = 'Buy from Black Market ($8) - RISKY!';
            }
            
            const illegalMarketBtn = document.querySelector('.illegal-market');
            if (gameState.money < 500) {
                illegalMarketBtn.classList.add('disabled');
                illegalMarketBtn.textContent = 'Buy from Underground ($500) - Need More Money';
            } else {
                illegalMarketBtn.classList.remove('disabled');
                illegalMarketBtn.textContent = 'Buy from Underground ($500) - VERY RISKY!';
            }
            
            const ticketBtn = document.getElementById('ticketBtn');
            if (gameState.money >= 1000) {
                ticketBtn.classList.remove('disabled');
                ticketBtn.style.background = '#2ecc71';
                ticketBtn.textContent = '✈️ ESCAPE TO ARABIA! ($1000)';
            } else {
                ticketBtn.classList.add('disabled');
                ticketBtn.style.background = '#f39c12';
                ticketBtn.textContent = 'Buy Plane Ticket to Arabia ($1000) - Need More Money';
            }
        }

        function addEvent(message, type = 'normal') {
            const eventsContainer = document.getElementById('eventsContainer');
            const eventDiv = document.createElement('div');
            eventDiv.className = `event event-${type}`;
            eventDiv.textContent = `Day ${gameState.day}: ${message}`;
            eventsContainer.insertBefore(eventDiv, eventsContainer.firstChild);
            
            // Keep only last 10 events
            while (eventsContainer.children.length > 10) {
                eventsContainer.removeChild(eventsContainer.lastChild);
            }
        }

        function getRandomTrinket() {
            return trinkets[Math.floor(Math.random() * trinkets.length)];
        }

        function addToInventory(item) {
            if (gameState.inventory[item]) {
                gameState.inventory[item]++;
            } else {
                gameState.inventory[item] = 1;
            }
        }

        function buyFromNormalMarket() {
            if (!gameState.gameRunning || gameState.money < 15) return;
            
            gameState.money -= 15;
            const trinket = getRandomTrinket();
            addToInventory(trinket);
            addEvent(`Bought ${trinket} from normal store for $15`, 'normal');
            updateDisplay();
        }

        function buyFromBlackMarket() {
            if (!gameState.gameRunning || gameState.blackMarketPurchasesToday >= 3 || gameState.money < 8) return;
            
            gameState.money -= 8;
            gameState.blackMarketPurchasesToday++;
            const trinket = getRandomTrinket();
            addToInventory(trinket);
            addEvent(`Bought ${trinket} from black market for $8 - Keep quiet!`, 'warning');
            updateDisplay();
        }

        function buyFromIllegalMarket() {
            if (!gameState.gameRunning || gameState.money < 500) return;
            
            // This is always a police trap!
            addEvent("POLICE STING OPERATION! You've been arrested!", 'danger');
            addEvent("The underground market was run by undercover cops!", 'danger');
            restartGame();
        }

        function sellAtAuction() {
            if (!gameState.gameRunning) return;
            
            const inventoryItems = Object.keys(gameState.inventory);
            if (inventoryItems.length === 0) {
                addEvent("No items to sell!", 'warning');
                return;
            }
            
            // Sell one random item
            const randomItem = inventoryItems[Math.floor(Math.random() * inventoryItems.length)];
            const salePrice = Math.floor(Math.random() * 15) + 10; // $10-24
            
            gameState.inventory[randomItem]--;
            if (gameState.inventory[randomItem] <= 0) {
                delete gameState.inventory[randomItem];
            }
            
            gameState.money += salePrice;
            addEvent(`Sold ${randomItem} at auction for $${salePrice}`, 'success');
            updateDisplay();
        }

        function buyTicket() {
            if (!gameState.gameRunning || gameState.money < 1000) return;
            
            // WIN CONDITION!
            addEvent("🎉 CONGRATULATIONS! You've escaped to Arabia with your fortune!", 'success');
            addEvent("You've won the game! Starting a new adventure...", 'success');
            
            setTimeout(() => {
                restartGame(true);
            }, 3000);
        }

        function restartGame(won = false) {
            if (!won) {
                addEvent("Game Over! Starting fresh...", 'danger');
            }
            
            gameState = {
                money: 50,
                day: 1,
                inventory: {},
                blackMarketPurchasesToday: 0,
                gameRunning: true,
                lastTaxDay: 0,
                lastPoliceDay: 0
            };
            
            setTimeout(() => {
                document.getElementById('eventsContainer').innerHTML = 
                    '<div class="event event-normal">Welcome to the trinket business! Buy low, sell high, avoid the law.</div>';
                updateDisplay();
            }, 2000);
        }

        function randomEvent() {
            if (!gameState.gameRunning) return;
            
            // Tax man visits every 3-5 days
            if (gameState.day - gameState.lastTaxDay >= Math.floor(Math.random() * 3) + 3) {
                if (gameState.money >= 5) {
                    gameState.money -= 5;
                    addEvent("Tax collector took $5!", 'warning');
                } else {
                    addEvent("Tax collector came but you're too poor to pay!", 'warning');
                }
                gameState.lastTaxDay = gameState.day;
            }
            
            // Police inspection every 4-7 days
            if (gameState.day - gameState.lastPoliceDay >= Math.floor(Math.random() * 4) + 4) {
                addEvent("Police are inspecting your shop...", 'warning');
                
                // Check if player has black market items (1/50 chance of getting caught)
                let hasBlackMarketItems = false;
                for (const item in gameState.inventory) {
                    if (Math.random() < 0.02) { // 1/50 chance per item
                        hasBlackMarketItems = true;
                        break;
                    }
                }
                
                if (hasBlackMarketItems) {
                    addEvent("Police found suspicious items! You've been arrested!", 'danger');
                    restartGame();
                    return;
                } else {
                    addEvent("Police inspection complete - nothing suspicious found.", 'normal');
                }
                gameState.lastPoliceDay = gameState.day;
            }
        }

        // Game loop - 1 real minute = 1 game day
        setInterval(() => {
            if (!gameState.gameRunning) return;
            
            gameState.day++;
            gameState.blackMarketPurchasesToday = 0; // Reset daily limit
            
            randomEvent();
            updateDisplay();
        }, 60000);

        // Initialize display
        updateDisplay();
    </script>
